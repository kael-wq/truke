{
  "name": "swapswap",
  "version": "1.0.0",
  "private": true,
  "description": "换换 SwapSwap - 闲置物品交换微信小程序（Taro + React + TS + 云开发）",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "dev:weapp": "npm run build:weapp -- --watch",
    "build:h5": "taro build --type h5",
    "dev:h5": "npm run build:h5 -- --watch"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.21.5",
    "@nutui/nutui-react-taro": "2.7.14",
    "@tarojs/components": "3.6.25",
    "@tarojs/helper": "3.6.25",
    "@tarojs/plugin-framework-react": "3.6.25",
    "@tarojs/plugin-platform-weapp": "3.6.25",
    "@tarojs/react": "3.6.25",
    "@tarojs/runtime": "3.6.25",
    "@tarojs/shared": "3.6.25",
    "@tarojs/taro": "3.6.25",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@babel/core": "^7.21.5",
    "@tarojs/cli": "3.6.25",
    "@tarojs/plugin-sass": "2.2.22",
    "@tarojs/webpack5-runner": "3.6.25",
    "@types/node": "^18.16.0",
    "@types/react": "^18.2.0",
    "@types/webpack-env": "^1.18.0",
    "babel-preset-taro": "3.6.25",
    "sass": "^1.63.0",
    "typescript": "^5.0.4",
    "webpack": "5.78.0"
  }
}
